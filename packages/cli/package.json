{
  "name": "@castable/cli",
  "version": "0.1.0",
  "description": "castable: a keyboard-driven setup wizard and live status for the Castable receiver.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "castable": "./bin/castable.mjs"
  },
  "scripts": {
